# Use the official Nginx image
FROM  nginx:1.29

# Set working directory
WORKDIR /var/www/fe/

# Ensure the target directory exists
RUN mkdir -p /var/www/fe

# Copy React build files to Nginx's serving directory
COPY build/ /var/www/fe/
COPY build/ /var/www/fe/

# Copy the Nginx configuration file
COPY setting/default.conf /etc/nginx/conf.d/default.conf

# Set correct permissions
RUN chmod -R 755 /var/www/fe && chown -R www-data:www-data /var/www/fe

# Expose port 80
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]


