FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY setting/default.conf /etc/nginx/conf.d/default.conf

# Copy React build output
COPY build/ /usr/share/nginx/html/


